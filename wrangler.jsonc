{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hvac-demo",
  "compatibility_date": "2026-08-01",

  // Static-asset-only Worker: Vite builds to ./dist and Cloudflare serves it
  // directly. There is no server-side code — this prototype has no backend.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "routes": [{ "pattern": "hvac.businesswebexpress.com", "custom_domain": true }]
}
